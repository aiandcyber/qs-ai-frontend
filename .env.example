# QS AI Frontend — environment template
# Copy to .env.local for local dev, or set the same keys in Cloudflare.
# Never commit real .env.local / .env.production files.

# Leave empty for local Vite proxy to http://localhost:8000
VITE_API_BASE=

VITE_DEFAULT_LOCALE=en

# Optional Auth0 SPA login (agent). Leave blank to disable auth.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
